# JUCE house style, as documented in docs/naming.md.
#
# The settings that matter and why: Allman braces and four-space indent because that is
# what JUCE uses and this is a JUCE plugin; a space before parentheses in calls because
# JUCE writes `foo (bar)`; a 100-column limit rather than 80, because the DSP here involves
# long qualified names and static_casts that read worse when wrapped.

Language: Cpp
BasedOnStyle: LLVM

AccessModifierOffset: -4
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignEscapedNewlines: Left
AlignOperands: Align
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
BreakBeforeBraces: Allman
BreakConstructorInitializers: BeforeColon
ColumnLimit: 100
ConstructorInitializerIndentWidth: 6
ContinuationIndentWidth: 4
Cpp11BracedListStyle: false
IndentCaseLabels: true
IndentWidth: 4
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
NamespaceIndentation: None
PointerAlignment: Left
SpaceAfterCStyleCast: true
SpaceBeforeParens: Always
SpacesInAngles: Never
Standard: c++20
TabWidth: 4
UseTab: Never

# Includes are grouped: this file's own header, then our headers, then JUCE, then third
# party, then the standard library. Not sorted across groups, because the order carries
# meaning — a translation unit's own header comes first so that it is proven
# self-sufficient.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
